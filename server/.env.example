NODE_ENV=development
PORT=3001

# Koneksi runtime Neon (pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Koneksi langsung untuk migration dan importer (tanpa PgBouncer).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Daftar origin frontend yang diizinkan, dipisahkan koma.
CORS_ORIGIN=http://localhost:5173

# Masa berlaku sesi dalam jam (default 168).
SESSION_TTL_HOURS=168

# Wajib true pada production; false hanya untuk development/test HTTP.
AUTH_COOKIE_SECURE=false

# Lax untuk topologi first-party; None hanya fallback cross-site dengan Secure=true.
AUTH_COOKIE_SAME_SITE=Lax

# Nama cookie sesi.
AUTH_COOKIE_NAME=ptm_session
