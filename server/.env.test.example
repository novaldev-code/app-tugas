NODE_ENV=test

# Wajib menunjuk Neon branch/database khusus test, bukan production.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/TEST_DATABASE?sslmode=require
TEST_DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/TEST_DATABASE?sslmode=require

# Nilai sesi/cookie untuk pengujian lokal (bukan secret).
SESSION_TTL_HOURS=168
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_NAME=ptm_session
