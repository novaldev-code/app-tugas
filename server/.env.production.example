NODE_ENV=production

# Render menyediakan PORT otomatis. Jangan hardcode port production di sini.
# PORT=10000

# Koneksi runtime Neon (pooled, hostname mengandung -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Koneksi langsung untuk migration/pre-deploy dan pemeriksaan migration.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Origin frontend production, tanpa path dan tanpa wildcard.
CORS_ORIGIN=https://app.example.com

SESSION_TTL_HOURS=168

# Wajib true di production. Cookie hanya dikirim melalui HTTPS.
AUTH_COOKIE_SECURE=true

# Gunakan Lax untuk domain same-site (app.example.com + api.example.com).
# Gunakan None hanya sebagai fallback cross-site; browser yang memblokir
# cookie pihak ketiga dapat membuat sesi gagal.
AUTH_COOKIE_SAME_SITE=Lax

AUTH_COOKIE_NAME=ptm_session
