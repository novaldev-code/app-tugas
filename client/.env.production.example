# Isi dengan origin backend production jika frontend memanggil API pada
# origin terpisah. Untuk cookie first-party, gunakan domain same-site
# (mis. https://api.example.com) atau rewrite/proxy /api same-origin.
VITE_API_URL=https://api.example.com

# Landing publik tetap tampil; /app hanya dapat diakses setelah login.
VITE_PUBLIC_DEPLOYMENT=true
